{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSpace",
  "version": "0.1.0",
  "identifier": "com.winspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "WinSpace",
      "width": 1320,
      "height": 820,
      "minWidth": 980,
      "minHeight": 650,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
